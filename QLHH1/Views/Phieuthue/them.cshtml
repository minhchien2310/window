@model QLHH1.Models.Phieuthue
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thêm phiếu thuê</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    @{
        QLHH1Context db = new QLHH1Context();
        SelectList DSKhachHang = new SelectList(db.Khachhangs.ToList(), "MaKh", "TenKh");
    }
    <div class="container mt-4" style="max-width: 600px;">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">Thêm phiếu thuê mới</h3>
            </div>
            <div class="card-body">
                <form asp-action="them" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MaPt" class="form-label"></label>
                        <input asp-for="MaPt" class="form-control" placeholder="Nhập đủ 10 ký tự" />
                        <span asp-validation-for="MaPt" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NgayThue" class="form-label"></label>
                        <input asp-for="NgayThue" type="date" class="form-control" />
                        <span asp-validation-for="NgayThue" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NgayTra" class="form-label"></label>
                        <input asp-for="NgayTra" type="date" class="form-control" />
                        <span asp-validation-for="NgayTra" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Gia" class="form-label"></label>
                        <input asp-for="Gia" type="number" class="form-control" />
                        <span asp-validation-for="Gia" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaKh" class="form-label">Khách hàng</label>
                        <select asp-for="MaKh" asp-items="@DSKhachHang" class="form-select"></select>
                        <span asp-validation-for="MaKh" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                        <button type="submit" class="btn btn-primary">Thêm mới</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>