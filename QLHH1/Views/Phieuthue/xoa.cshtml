@using QLHH1.Models
@model QLHH1.Models.Phieuthue
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xóa phiếu thuê</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4" style="max-width: 600px;">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0">Xác nhận xóa phiếu thuê</h3>
            </div>
            <div class="card-body">
                <!-- Form gửi action xoa kèm id phiếu thuê -->
                <form asp-action="xoa" asp-route-id="@Model?.MaPt" method="post">

                    <div class="mb-3">
                        <label asp-for="MaPt" class="form-label fw-bold"></label>
                        <input asp-for="MaPt" readonly class="form-control-plaintext ps-2 border rounded bg-light" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NgayThue" class="form-label fw-bold"></label>
                        <div class="form-control-plaintext ps-2 border rounded bg-light">
                            @(Model?.NgayThue != null ? Model.NgayThue.ToString("dd/MM/yyyy") : "")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NgayTra" class="form-label fw-bold"></label>
                        <div class="form-control-plaintext ps-2 border rounded bg-light">
                            @(Model?.NgayTra != null ? Model.NgayTra.ToString("dd/MM/yyyy") : "")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Gia" class="form-label fw-bold"></label>
                        <div class="form-control-plaintext ps-2 border rounded bg-light">
                            @Model?.Gia.ToString("N0")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaKh" class="form-label fw-bold"></label>
                        <div class="form-control-plaintext ps-2 border rounded bg-light">
                            @Model?.MaKh
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaKhNavigation.TenKh" class="form-label fw-bold"></label>
                        <div class="form-control-plaintext ps-2 border rounded bg-light">
                            @Model?.MaKhNavigation?.TenKh
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoNgayThue" class="form-label fw-bold"></label>
                        <div class="form-control-plaintext ps-2 border rounded bg-light">
                            @Model?.SoNgayThue
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ThanhTien" class="form-label fw-bold"></label>
                        <div class="form-control-plaintext ps-2 border rounded bg-light">
                            @Model?.ThanhTien.ToString("N0")
                        </div>
                    </div>

                    <div class="alert alert-warning mb-3" role="alert">
                        Bạn có chắc chắn muốn xóa phiếu thuê này khỏi hệ thống?
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger">Xóa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>